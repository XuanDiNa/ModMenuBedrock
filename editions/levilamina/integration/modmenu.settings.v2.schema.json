{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModMenuBedrock settings description v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "plugin", "config", "fields"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 512},
    "schemaVersion": {"const": 2},
    "plugin": {
      "type": "object", "additionalProperties": false, "required": ["id", "entry", "versions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
        "entry": {"type": "string", "minLength": 5, "maxLength": 120, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.dll$"},
        "versions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^*]+$"}}
      }
    },
    "config": {
      "type": "object", "additionalProperties": false, "required": ["file", "reload"],
      "properties": {
        "file": {"type": "string", "minLength": 6, "maxLength": 120, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.json$"},
        "reload": {"enum": ["hot", "restart"]}
      }
    },
    "fields": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/field"}}
  },
  "$defs": {
    "line": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F§]+$"},
    "text": {"oneOf": [
      {"$ref": "#/$defs/line"},
      {"type": "object", "additionalProperties": false, "required": ["en_US"], "properties": {"en_US": {"$ref": "#/$defs/line"}, "zh_TW": {"$ref": "#/$defs/line"}, "zh_CN": {"$ref": "#/$defs/line"}}}
    ]},
    "paragraph": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u0009\\u000B\\u000C\\u000E-\\u001F\\u007F§]+$"},
    "help": {"oneOf": [
      {"$ref": "#/$defs/paragraph"},
      {"type": "object", "additionalProperties": false, "required": ["en_US"], "properties": {"en_US": {"$ref": "#/$defs/paragraph"}, "zh_TW": {"$ref": "#/$defs/paragraph"}, "zh_CN": {"$ref": "#/$defs/paragraph"}}}
    ]},
    "key": {"type": "string", "pattern": "^(NONE|INSERT|DELETE|HOME|END|PAGEUP|PAGEDOWN|PAUSE|LALT|RALT|LCTRL|RCTRL|LSHIFT|RSHIFT|SPACE|F([1-9]|1[0-9]|2[0-4])|[A-Z0-9])$"},
    "fixed": {"type": "number", "minimum": -2147483648, "maximum": 2147483647},
    "field": {
      "type": "object", "additionalProperties": false, "required": ["path", "type", "default", "label"],
      "properties": {
        "path": {"type": "string", "minLength": 2, "maxLength": 256, "pattern": "^/"},
        "type": {"enum": ["boolean", "integer", "choice", "key", "slider"]},
        "default": {}, "label": {"$ref": "#/$defs/text"}, "category": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/help"},
        "min": {"$ref": "#/$defs/fixed"}, "max": {"$ref": "#/$defs/fixed"}, "step": {"type": "number", "exclusiveMinimum": 0, "maximum": 2147483647},
        "unit": {"type": "string", "minLength": 1, "maxLength": 16},
        "options": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/text"}},
        "keys": {"type": "array", "minItems": 1, "maxItems": 96, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
        "numberType": {"enum": ["integer", "decimal"]}, "precision": {"type": "integer", "minimum": 1, "maximum": 6}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "boolean"}}}, "then": {"properties": {"default": {"type": "boolean"}}}},
        {"if": {"properties": {"type": {"const": "integer"}}}, "then": {"required": ["min", "max"], "properties": {"default": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}, "step": {"type": "integer", "minimum": 1}}}},
        {"if": {"properties": {"type": {"enum": ["integer", "slider"]}}}, "else": {"not": {"anyOf": [{"required": ["min"]}, {"required": ["max"]}, {"required": ["step"]}, {"required": ["unit"]}]}}},
        {"if": {"properties": {"type": {"const": "choice"}}}, "then": {"required": ["options"], "properties": {"default": {"type": "integer", "minimum": 0, "maximum": 5}}}, "else": {"not": {"required": ["options"]}}},
        {"if": {"properties": {"type": {"const": "key"}}}, "then": {"required": ["keys"], "properties": {"default": {"$ref": "#/$defs/key"}}}, "else": {"not": {"required": ["keys"]}}},
        {"if": {"properties": {"type": {"const": "slider"}}}, "then": {
          "required": ["numberType", "min", "max", "step"], "properties": {"default": {"$ref": "#/$defs/fixed"}},
          "allOf": [{"if": {"properties": {"numberType": {"const": "decimal"}}}, "then": {"required": ["precision"]}, "else": {"not": {"required": ["precision"]}, "properties": {"min": {"type": "integer"}, "max": {"type": "integer"}, "step": {"type": "integer"}, "default": {"type": "integer"}}}}]
        }, "else": {"not": {"anyOf": [{"required": ["numberType"]}, {"required": ["precision"]}]}}}
      ]
    }
  }
}
